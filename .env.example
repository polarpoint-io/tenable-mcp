# Tenable.io API credentials
# Generate in Tenable.io: Settings -> My Account -> API Keys
TIO_ACCESS_KEY=your_access_key_here
TIO_SECRET_KEY=your_secret_key_here

# Optional: override the API endpoint (defaults to https://cloud.tenable.com)
# TIO_URL=https://cloud.tenable.com

# Transport: "stdio" (default) or "http"
# TRANSPORT=stdio

# When TRANSPORT=http
# HTTP_HOST=0.0.0.0
# HTTP_PORT=8000
